# Sao chép thành .env (KHÔNG commit). Trên Vercel: Settings > Environment Variables.
# Lấy ở Supabase: Project Settings > API.

# Địa chỉ project (an toàn để công khai)
VITE_SUPABASE_URL=
# Khóa "anon public" (an toàn để công khai vì đã có RLS bảo vệ)
VITE_SUPABASE_ANON_KEY=

# TUYỆT ĐỐI KHÔNG đặt khóa "service_role" vào file này, vào repo hay vào chat.
# Khóa service_role bỏ qua mọi bảo mật; chỉ dùng ở backend và chỉ đặt trong biến môi trường của máy chủ.
